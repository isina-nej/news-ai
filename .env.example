# Copy to .env. No real secrets here.
DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.local
DATABASE_URL=mysql://newsai:newsai@mysql:3306/newsai
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Telegram ingestion (Kurigram user session, env-only; never stored in DB)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_ACCOUNT_KEY=default
TELEGRAM_WORKER_CONCURRENCY=1
SESSION_ENCRYPTION_KEY=

# Telegram publishing (Bot API, official exception)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Twitter/X stub phase 1
TWITTER_SESSION=
ENABLE_TWITTER_SOURCE=false

# AI provider-agnostic (OpenAI-compatible)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_CHEAP_MODEL=
AI_STRONG_MODEL=

# RSSHub self-hosted (optional, website ingestion fallback)
RSSHUB_BASE_URL=http://rsshub:1200
RSSHUB_ACCESS_KEY=

# Learning / publishing knobs (DB-overridable, env = defaults)
ENABLE_AI_CLUSTERING=false
ENABLE_AUTO_PUBLISH=false
EXPLORATION_RATE=0.05
SNAPSHOT_SCHEDULE_MIN=10,30,60,180,360,720,1440
