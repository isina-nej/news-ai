# Copy to .env. No real secrets here.
#
# Host quick dev uses config.settings.local (SQLite/LocMem, eager Celery).
# Docker Compose overrides these with config.settings.docker
# (real MySQL/Redis/Qdrant) via docker-compose.yml x-app-environment.
DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.local
DATABASE_URL=mysql://newsai:newsai@mysql:3306/newsai
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
QDRANT_URL=http://qdrant:6333
EMBEDDING_PROVIDER=fake

# Telegram ingestion (Kurigram user session, env-only; never stored in DB)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_ACCOUNT_KEY=default
TELEGRAM_WORKER_CONCURRENCY=1
SESSION_ENCRYPTION_KEY=

# Telegram publishing (Bot API, official exception)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Twitter/X stub phase 1
TWITTER_SESSION=
ENABLE_TWITTER_SOURCE=false

# AI provider-agnostic (OpenAI-compatible)
AI_PROVIDER=fake
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MODEL_CHEAP=
AI_MODEL_STRONG=
AI_TIMEOUT=30.0
AI_MAX_RETRIES=2
AI_CACHE_TTL_SECONDS=86400

# RSSHub self-hosted (optional, website ingestion fallback)
RSSHUB_BASE_URL=http://rsshub:1200
RSSHUB_ACCESS_KEY=

# Learning / publishing knobs (DB-overridable, env = defaults)
ENABLE_AI=true
ENABLE_AI_CLUSTERING=false
ENABLE_AUTO_PUBLISH=false
ENABLE_TWITTER_SOURCE=false
ENABLE_QDRANT=true
ENABLE_AUDIENCE_LEARNING=true
ENABLE_EXPLORATION=true
EXPLORATION_RATE=0.05
SNAPSHOT_SCHEDULE_MIN=10,30,60,180,360,720,1440
